// Naranja Pimienta — Esquema de base de datos (PostgreSQL 16)
// Prisma 7
//
// Notas de diseño:
// - `Membership` es la única fuente de verdad de la pertenencia usuario ↔ organización.
// - Un usuario puede tener varios roles dentro de una organización (`Membership.roles`).
// - La tasa de IVA es un ajuste del negocio (`Organization.taxRate`, 16 % por defecto) y
//   se aplica a los productos que no tengan una tasa propia (`Product.taxRate`).
// - Los precios del catálogo son precios finales con IVA incluido (`plan.md` §6.9).
// - Los estados son enums para que la base de datos rechace valores inválidos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
  INVENTORY_MANAGER
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderRoundStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum InventoryMovementType {
  ADJUSTMENT
  CONSUMPTION
  RETURN
  PRODUCTION
}

enum TwoFactorPurpose {
  LOGIN
  ENABLE
}

/// Unidad de medida. La dimensión y el factor a la unidad base viven en código
/// (`src/common/units.ts`): masa (base g), volumen (base ml) y conteo (base
/// pieza = UNIT). El catálogo es fijo: no se edita desde la aplicación.
enum UnitCode {
  MG
  G
  KG
  OZ
  LB
  ML
  L
  TSP
  TBSP
  CUP
  FL_OZ
  GAL
  UNIT
  HALF_PIECE
  PAIR
  HALF_DOZEN
  DOZEN
}

/// Tipo de categoría: agrupa artículos vendibles o recetas/preparaciones.
enum CategoryKind {
  ARTICLE
  RECIPE
}

// ============================================================================
// Identidad y organización
// ============================================================================

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  domain            String?  @unique // dominio de los usuarios del equipo (ej. naranjapimienta.cafe)
  taxRate           Decimal  @default(0.16) @db.Decimal(5, 4) // IVA por defecto del negocio (0.16 = 16 %)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Onboarding fields
  businessType    String?      // Giro principal: restaurante, cafetería, etc.
  serviceTypes    String[]     @default([]) // Modelo de servicio: mesa, mostrador, etc.
  goals           String[]     @default([]) // Objetivos: inventario, costos, etc.
  hasBranches     Boolean      @default(false) // "Tengo sucursales"
  /// Mostrar/activar la sección de insumos core sugeridos en Configuración.
  useCoreSuggestions Boolean  @default(true)

  memberships             Membership[]
  branches                Branch[]
  orders                  Order[]
  payments                Payment[]
  inventoryMovements      InventoryMovement[]
  auditLogs               AuditLog[]
  categories              Category[]
  items                   Item[]
  ingredients             Ingredient[]
  recipes                 Recipe[]
  ingredientCategories    IngredientCategory[]
  ingredientLocations     IngredientLocation[]
}

model User {
  id                     String      @id @default(cuid())
  email                  String?     @unique
  username               String?     @unique // login de cuentas internas (minúsculas)
  passwordHash           String?
  name                   String?
  googleId               String?     @unique // `sub` de Google (OpenID Connect)
  isActive               Boolean     @default(true)
  emailVerified          Boolean     @default(false)
  twoFactorEnabled       Boolean     @default(false)
  onboardedAt            DateTime? // null hasta completar el onboarding
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  memberships            Membership[]
  authSessions           AuthSession[]
  twoFactorCodes         TwoFactorCode[]
  orders                 Order[]
  payments               Payment[]   @relation("PaymentUser")
  confirmedPayments      Payment[]   @relation("PaymentConfirmedBy")
  inventoryMovements     InventoryMovement[]
  auditLogs              AuditLog[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  orderStatusHistories   OrderStatusHistory[]

  @@index([isActive])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  branchId       String? // null = acceso a todas las sucursales
  roles          Role[]   @default([WAITER])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([branchId])
}

/// Sucursal física del negocio. Por ahora agrupa al personal; el inventario y
/// los pedidos se irán vinculando por fases para no mezclar existencias.
model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  stock          BranchStock[]
  movements      InventoryMovement[]
  orders         Order[]
  payments       Payment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Existencia de un ingrediente en una sucursal concreta.
///
/// `Ingredient.currentStock` sigue siendo el total de la organización; este
/// registro permite operar cada local por separado sin perder el consolidado.
model BranchStock {
  id           String   @id @default(cuid())
  branchId     String
  ingredientId String
  quantity     Decimal  @db.Decimal(12, 4) @default(0.0000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([branchId, ingredientId])
  @@index([ingredientId])
}

model AuthSession {
  id                  String   @id @default(cuid())
  userId              String
  refreshTokenHash    String   @unique
  expiresAt           DateTime // expiración del refresh token actual
  absoluteExpiresAt   DateTime // expiración absoluta de la sesión (límite de rotación)
  revokedAt           DateTime?
  revokedReason       String?  // "LOGOUT", "ROTATED", "REUSE_DETECTED", "PASSWORD_CHANGED"
  replacedBySessionId String?
  userAgent           String?
  ip                  String?
  lastUsedAt          DateTime?
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorCode {
  id          String           @id
  userId      String
  purpose     TwoFactorPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Catálogo
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  organizationId String?
  /// Identificador estable de las categorías core (breakfast, sauces, …).
  code        String?
  name        String
  description String?
  isCore      Boolean  @default(false) // true = parte del core, no editable
  kind        CategoryKind @default(ARTICLE)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items       Item[]
  recipes     Recipe[]

  @@unique([organizationId, kind, name])
  @@unique([kind, code])
  @@index([organizationId])
  @@index([kind, isCore])
}

/// Artículo del catálogo (lo que se vende en el POS).
/// La tabla sigue llamándose `Product` para no migrar la base.
model Item {
  id            String   @id @default(cuid())
  organizationId String?
  categoryId    String?
  name          String
  description   String?
  sku           String?  // Código interno / importación CSV
  imageKey      String?  // Objeto en R2 (nombre hasheado); la URL se deriva
  imageUrl      String?
  /// Nombre normalizado y legible de la imagen (sin guiones ni extensión).
  imageName     String?
  price         Decimal  @db.Decimal(12, 2) // Precio final con IVA incluido
  taxRate       Decimal? @db.Decimal(5, 4) // Tasa aplicable; null = no configurada (no se asume ninguna)
  isActive      Boolean  @default(true)
  isCombo       Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id])
  variants      ItemVariant[]
  extras        ItemExtra[]
  recipes       Recipe[]
  orderItems    OrderItem[]  @relation("OrderItemRef")
  ingredientExclusions ItemIngredientExclusion[]
  comboComponents ComboComponent[] @relation("ComboComponents")
  componentOf   ComboComponent[]   @relation("ComboPartOf")

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("Product")
}

model ItemVariant {
  id          String   @id @default(cuid())
  itemId      String   @map("productId")
  name        String   // ej: "Chico", "Regular", "Grande", "Sin azúcar"
  /// SKU propio: el del artículo más el sufijo de la presentación (XVA101A).
  sku         String?
  /// Presentación que el menú muestra por defecto. Solo una por artículo.
  isPrimary   Boolean  @default(false)
  priceAdjust Decimal  @db.Decimal(12, 2) @default(0.0000)
  /// Multiplicador del consumo de la receta base. Regular = 1.
  recipeFactor Decimal @db.Decimal(6, 3) @default(1)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item        Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  recipes     Recipe[]
  comboComponents ComboComponent[]

  @@index([itemId])
  @@map("ProductVariant")
}

model ItemExtra {
  id          String   @id @default(cuid())
  itemId      String   @map("productId")
  name        String
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item        Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItemExtras OrderItemExtra[]
  ingredients ItemExtraIngredient[]

  @@index([itemId])
  @@map("ProductExtra")
}

// ============================================================================
// Inventario y recetas
// ============================================================================

model Ingredient {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  sku            String?  // Código interno / referencia proveedor
  /** Unidad canónica de almacenamiento: siempre G, ML o UNIT. */
  baseUnit       UnitCode @default(UNIT)
  /** Unidad con la que el usuario ve y captura las cantidades (misma dimensión). */
  displayUnit    UnitCode @default(UNIT)
  currentStock   Decimal  @db.Decimal(12, 4) @default(0.0000)
  minStock       Decimal  @db.Decimal(12, 4) @default(0.0000)
  maxStock       Decimal? @db.Decimal(12, 4) // Existencia máxima (opcional)
  unitCost       Decimal? @db.Decimal(12, 6) // Costo por unidad canónica
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId     String?
  locationId     String?

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location       IngredientLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  ingredientOptions RecipeIngredientOption[]
  orderChoices OrderItemIngredientChoice[]
  producedByRecipe Recipe? @relation("RecipeProducedIngredient")
  inventoryMovements InventoryMovement[]
  equivalences   IngredientEquivalence[]
  exclusions     ItemIngredientExclusion[]
  extraIngredients ItemExtraIngredient[]
  orderItemExclusions OrderItemExclusion[]
  branchStocks   BranchStock[]

  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
}

/// Equivalencia explícita entre dimensiones distintas para UN ingrediente
/// (ej. 1 taza de harina = 120 g). Nunca se deduce masa ↔ volumen.
/// Las unidades implicadas se normalizan a la canónica de su dimensión.
model IngredientCategory {
  id            String   @id @default(cuid())
  organizationId String?
  name          String
  description   String?
  isCore        Boolean  @default(false) // true = parte del core de la app, no editable
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients   Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientLocation {
  id            String   @id @default(cuid())
  organizationId String?
  name          String
  description   String?
  isCore        Boolean  @default(false) // true = parte del core de la app, no editable
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients   Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model IngredientEquivalence {
  id           String   @id @default(cuid())
  ingredientId String
  fromUnit     UnitCode
  toUnit       UnitCode
  factor       Decimal  @db.Decimal(12, 6) // 1 fromUnit = factor toUnit
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, fromUnit, toUnit])
  @@index([ingredientId])
}

/// Ingredientes que el cliente puede pedir sin incluir ("sin cebolla").
model ItemIngredientExclusion {
  id           String   @id @default(cuid())
  itemId       String   @map("productId")
  ingredientId String
  label        String?
  createdAt    DateTime @default(now())

  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemId, ingredientId])
  @@index([itemId])
  @@index([ingredientId])
  @@map("ProductIngredientExclusion")
}

/// Componentes de un combo. No se permiten combos anidados (validación en API).
model ComboComponent {
  id                 String   @id @default(cuid())
  comboId            String
  componentItemId    String   @map("componentProductId")
  componentVariantId String?
  quantity           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  combo              Item         @relation("ComboComponents", fields: [comboId], references: [id], onDelete: Cascade)
  componentItem      Item         @relation("ComboPartOf", fields: [componentItemId], references: [id], onDelete: Restrict)
  variant            ItemVariant? @relation(fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([comboId, componentItemId, componentVariantId])
  @@index([comboId])
  @@index([componentItemId])
}

/// Consumo de inventario de un extra (cantidad en la unidad canónica del ingrediente).
model ItemExtraIngredient {
  id             String   @id @default(cuid())
  itemExtraId    String   @map("productExtraId")
  ingredientId   String
  quantity       Decimal  @db.Decimal(12, 4)

  itemExtra      ItemExtra  @relation(fields: [itemExtraId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([itemExtraId, ingredientId])
  @@index([ingredientId])
  @@map("ProductExtraIngredient")
}

model Recipe {
  id            String   @id @default(cuid())
  organizationId String?
  /// `null` = receta independiente (aún no publicada como artículo).
  itemId        String?  @map("productId")
  variantId     String? // null = receta base del artículo
  categoryId    String?
  name          String
  description   String?
  /// Insumo que produce esta receta (ej. salsa verde). Único por receta.
  producesIngredientId String? @unique
  yieldQuantity Decimal? @db.Decimal(12, 4)
  yieldUnit     UnitCode?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item          Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant       ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  producesIngredient Ingredient? @relation("RecipeProducedIngredient", fields: [producesIngredientId], references: [id], onDelete: SetNull)
  ingredients   RecipeIngredient[]

  @@unique([itemId, variantId])
  @@index([organizationId])
  @@index([variantId])
  @@index([categoryId])
}

model RecipeIngredient {
  id            String   @id @default(cuid())
  recipeId      String
  /// Insumo default del slot (puede cambiarse al pedir entre las alternativas).
  ingredientId  String
  /// Nombre del slot (ej. "Leche"); si falta se usa el nombre del insumo.
  label         String?
  quantity      Decimal  @db.Decimal(12, 4) // Cantidad en la unidad canónica del ingrediente
  isOptional    Boolean  @default(false)
  sortOrder     Int      @default(0)

  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  options       RecipeIngredientOption[]
  orderChoices  OrderItemIngredientChoice[]

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

/// Alternativa de un ingrediente de receta (ej. leche deslactosada o de coco).
/// Cada alternativa guarda su propia cantidad en la unidad canónica de su insumo.
model RecipeIngredientOption {
  id                 String   @id @default(cuid())
  recipeIngredientId String
  ingredientId       String
  quantity           Decimal  @db.Decimal(12, 4)
  sortOrder          Int      @default(0)

  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeIngredientId, ingredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

/// Opción elegida al vender una línea (soporte para cambiar el default en pedidos).
model OrderItemIngredientChoice {
  id                 String @id @default(cuid())
  orderItemId        String
  recipeIngredientId String
  ingredientId       String

  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  recipeIngredient RecipeIngredient @relation(fields: [recipeIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, recipeIngredientId])
  @@index([recipeIngredientId])
  @@index([ingredientId])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String?
  /// `null` si el producto se eliminó; el kardex se conserva.
  ingredientId    String?
  /// Nombre del producto en el momento del movimiento (snapshot).
  ingredientName  String
  /// Unidad visible del producto en el momento del movimiento.
  displayUnit     UnitCode
  userId          String?
  type            InventoryMovementType
  quantity        Decimal  @db.Decimal(12, 4) // Positivo = entrada, Negativo = salida
  stockAfter      Decimal? @db.Decimal(12, 4) // Saldo resultante (kardex auditable)
  reason          String?
  referenceId     String?  // ID de orden, ronda, etc.
  referenceType   String?  // "ORDER_ROUND", "ADJUSTMENT", etc.
  dedupeKey       String?  @unique // idempotencia de consumos
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine el producto.
  ingredient      Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  // `SetNull`: el kardex se conserva aunque se elimine la cuenta del autor.
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([ingredientId])
  @@index([userId])
}

// ============================================================================
// Pedidos y cocina
// ============================================================================

model Order {
  id            String   @id @default(cuid())
  organizationId String?
  branchId      String?
  tableNumber   String?
  isTakeaway    Boolean  @default(false)
  status        OrderStatus @default(OPEN)
  subtotal      Decimal  @db.Decimal(12, 2) @default(0.0000)
  taxTotal      Decimal  @db.Decimal(12, 2) @default(0.0000)
  total         Decimal  @db.Decimal(12, 2) @default(0.0000)
  idempotencyKey String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // `SetNull`: al eliminar la cuenta del usuario el pedido se conserva sin autor.
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  rounds        OrderRound[]
  payments      Payment[]

  @@index([organizationId, status, createdAt])
  @@index([branchId, status, createdAt])
}

model OrderRound {
  id            String   @id @default(cuid())
  orderId       String
  status        OrderRoundStatus @default(PENDING)
  idempotencyKey String? @unique
  sentAt        DateTime?
  startedAt     DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([orderId])
  @@index([status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderRoundId  String
  itemId        String   @map("productId")
  itemVariantId String?  @map("productVariantId")
  // Copia histórica del catálogo al momento del pedido
  itemName      String   @map("productName")
  variantName   String?
  itemPrice     Decimal  @db.Decimal(12, 2) @map("productPrice")
  taxRate       Decimal? @db.Decimal(5, 4)
  taxAmount     Decimal  @db.Decimal(12, 2) @default(0)
  quantity      Int      @default(1)
  notes         String?
  subtotal      Decimal  @db.Decimal(12, 2)

  orderRound    OrderRound @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  item          Item   @relation("OrderItemRef", fields: [itemId], references: [id], onDelete: Restrict)
  variant       ItemVariant? @relation(fields: [itemVariantId], references: [id])
  extras        OrderItemExtra[]
  exclusions    OrderItemExclusion[]
  ingredientChoices OrderItemIngredientChoice[]

  @@index([orderRoundId])
  @@index([itemId])
}

model OrderItemExtra {
  id            String   @id @default(cuid())
  orderItemId   String
  itemExtraId   String?  @map("productExtraId")
  extraName     String
  extraPrice    Decimal  @db.Decimal(12, 2)

  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  itemExtra     ItemExtra? @relation(fields: [itemExtraId], references: [id])

  @@index([orderItemId])
}

/// Ingredientes que el cliente pidió quitar. Se descuentan de la receta al
/// consumir inventario, para que el descuento coincida con lo servido.
model OrderItemExclusion {
  id           String @id @default(cuid())
  orderItemId  String
  ingredientId String

  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, ingredientId])
  @@index([ingredientId])
}

model OrderStatusHistory {
  id            String   @id @default(cuid())
  orderRoundId  String
  previousStatus String?
  newStatus     String
  changedById   String?
  changedAt     DateTime @default(now())
  reason        String?

  orderRound    OrderRound @relation(fields: [orderRoundId], references: [id], onDelete: Cascade)
  // `SetNull`: la traza de estados se conserva sin autor si se borra la cuenta.
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderRoundId])
  @@index([changedAt])
}

// ============================================================================
// Pagos y auditoría
// ============================================================================

model Payment {
  id            String   @id @default(cuid())
  organizationId String?
  branchId      String?
  orderId       String
  userId        String?
  method        PaymentMethod
  amount        Decimal  @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  idempotencyKey String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // `SetNull`: el pago sobrevive al borrado de la cuenta que lo registró.
  user          User?    @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  confirmedBy   User?    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([branchId, createdAt])
  @@index([orderId])
}

model AuditLog {
  id            String   @id @default(cuid())
  organizationId String?
  userId        String?
  action        String
  entity        String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  createdAt     DateTime @default(now())

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // `SetNull`: la auditoría se conserva aunque la cuenta ya no exista.
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}
