# Naranja Pimienta — API variables de entorno (ejemplo, sin secretos reales)

NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL (Docker Desktop, puerto 55432 en el host)
DATABASE_URL="postgresql://np_user:np_password@localhost:55432/np_db?schema=public"

# Origen del frontend (para CORS y cookies)
WEB_ORIGIN="http://localhost:3000"

# Origen público de la API (se acepta como Origin válido para Swagger y CSRF)
API_PUBLIC_ORIGIN="http://localhost:3001"

# Cookies (ajustar según despliegue)
COOKIE_DOMAIN=

# JWT secretos (cambiar en producción, nunca subir valores reales al repositorio)
JWT_ACCESS_SECRET="cambiar-en-produccion"
JWT_REFRESH_SECRET="cambiar-en-produccion"

# Correo (Resend). En desarrollo, si el remitente no es un dominio verificado,
# los correos se guardan en api/.mail-outbox/mails.jsonl y no se llama a Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="no-reply@naranjapimienta.local"

# Cloudflare R2 para imágenes de catálogo (bucket público `sazona-public`).
# El navegador sube directo al bucket con una URL firmada (PUT); la API solo
# guarda la clave del objeto. Estructura (una carpeta por artículo):
#   {organización}/catalog/{itemId}/{hash}.{ext}
# El nombre del objeto es un hash (privacidad); el nombre legible
# (`snap{nombre}{DDMMYYHHMM}`) se guarda en `Item.imageName` de la base.
# La imagen se sube al guardar el artículo y, al reemplazarla, se borra la
# anterior: solo hay un objeto por artículo. No hay área temporal.
# CORS del bucket: AllowedOrigins = WEB_ORIGIN, AllowedMethods = GET, PUT, HEAD
# y AllowedHeaders = Content-Type (el navegador hace preflight del PUT).
# R2 todavía no soporta presigned POST: no cambiar la subida a POST.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET="sazona-public"
# Dominio público del bucket, sin barra final (p. ej. https://img.ejemplo.com)
R2_PUBLIC_BASE_URL=
# Opcional: endpoint S3 alternativo (por defecto se deriva de R2_ACCOUNT_ID)
R2_ENDPOINT=
# Tamaño máximo por imagen en bytes (5 MB)
R2_MAX_UPLOAD_BYTES=5242880

# Google OAuth (opcional). Si se configuran ambas, se habilita /v1/auth/google.
# La redirect URI debe coincidir exactamente con la registrada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto: ${API_PUBLIC_ORIGIN}/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
